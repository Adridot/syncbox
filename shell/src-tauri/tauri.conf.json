{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syncbox",
  "version": "../../ui/package.json",
  "identifier": "dev.syncbox.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "frontendDist": "../../ui/dist",
    "beforeBuildCommand": "pnpm build && pnpm freeze"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Syncbox",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "resources": {
      "../../sidecar/dist/syncbox-sidecar": "sidecar"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  }
}
