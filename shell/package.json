{
  "name": "syncbox-shell",
  "private": true,
  "version": "0.2.3",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "24.13.0",
    "pnpm": "10.29.3"
  },
  "scripts": {
    "dev": "pnpm --dir ../ui dev",
    "build": "pnpm --dir ../ui build",
    "tauri": "tauri",
    "freeze:component": "cd ../optional-component && uv run --locked --exact --managed-python pyinstaller --noconfirm --clean syncbox-deezer-component.spec && uv run --locked --exact --managed-python python ../scripts/package_optional_component.py",
    "freeze:base": "cd ../sidecar && uv run --locked --exact --managed-python pyinstaller --noconfirm --clean sidecar.spec",
    "freeze": "pnpm freeze:component && pnpm freeze:base",
    "bundle:macos": "python3 ../scripts/build_macos_release.py",
    "dmg:macos": "python3 ../scripts/package_base_dmg.py"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0"
  },
  "license": "MIT"
}
