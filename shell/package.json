{
  "name": "syncbox-shell",
  "private": true,
  "version": "0.2.1",
  "scripts": {
    "dev": "pnpm --dir ../ui dev",
    "build": "pnpm --dir ../ui build",
    "tauri": "tauri",
    "freeze": "cd ../sidecar && uv run --locked --managed-python pyinstaller --noconfirm --clean sidecar.spec",
    "bundle:macos": "PATH=/usr/bin:/bin:$PATH RUSTFLAGS=\"--remap-path-prefix=$HOME=/Users/build\" tauri build --bundles app --target aarch64-apple-darwin -- --locked"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0"
  },
  "license": "MIT"
}
